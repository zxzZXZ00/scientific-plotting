font.family: Arial
font.style: normal
mathtext.fontset: custom
mathtext.rm: Arial
mathtext.it: Arial:italic
mathtext.default: regular
font.size: 7
axes.labelsize: 10
axes.linewidth: 0.65
axes.edgecolor: .35
axes.spines.top: True
axes.spines.right: True
axes.spines.bottom: True
axes.spines.left: True
xtick.labelsize: 7
ytick.labelsize: 7
xtick.major.size: 2
ytick.major.size: 2
xtick.major.width: .5
ytick.major.width: .5
xtick.direction: out
ytick.direction: out
legend.frameon: False
legend.fontsize: 6.5
lines.linewidth: .8
savefig.facecolor: white
svg.fonttype: none
